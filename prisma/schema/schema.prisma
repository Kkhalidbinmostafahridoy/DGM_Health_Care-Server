model Prescription {
  id            String      @id @default(uuid())
  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id])
  patientId     String
  patient       Patient     @relation(fields: [patientId], references: [id])
  doctorId      String
  doctor        Doctor      @relation(fields: [doctorId], references: [id])
  instruction   String
  followUpdates DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@map("prescription")
}

model PatientHealthData {
  id                                String        @id @default(uuid())
  patientId                         String
  patient                           Patient       @relation(fields: [patientId], references: [id])
  gender                            UserGender
  dateOfBirth                       DateTime
  bloodGroup                        BloodGroup
  hasAllergies                      Boolean?      @default(false)
  hasDiabetes                       Boolean?      @default(false)
  hasHypertension                   Boolean?      @default(false)
  smokingStatus                     Boolean?      @default(false)
  alcoholConsumption                Boolean?      @default(false)
  dietaryPreferences                String?
  pregnancyStatus                   Boolean?      @default(false)
  mentalHealthStatus                String?
  immunizationStatus                String?
  hasPastSurgeries                  Boolean?      @default(false)
  hasChronicConditions              Boolean?      @default(false)
  recentAnxietyOrDepressionSymptoms Boolean?      @default(false)
  recentStressLevels                String?
  maritalStatus                     MaritalStatus @default(Single)
  occupation                        String?
  height                            Float
  weight                            Float
  bloodType                         String
  allergies                         String?
  medicalHistory                    String?
  createdAt                         DateTime      @default(now())
  updatedAt                         DateTime      @updatedAt

  @@map("patient_health_data")
}

model MedicalReport {
  id            String    @id @default(uuid())
  patientId     String
  patient       Patient   @relation(fields: [patientId], references: [id])
  doctorId      String
  doctor        Doctor    @relation(fields: [doctorId], references: [id])
  reportTitle   String?
  reportName    String
  reportSummary String?
  reportLink    String
  reportType    String?
  reportDate    DateTime?
  reportFileUrl String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("medical_reports")
}

model Review {
  id            String      @id @default(uuid())
  patientId     String
  patient       Patient     @relation(fields: [patientId], references: [id])
  doctorId      String
  doctor        Doctor      @relation(fields: [doctorId], references: [id])
  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id])
  rating        Float
  comment       String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@map("reviews")
}

enum MaritalStatus {
  Single
  Married
  Divorced
  Widowed
}

enum BloodGroup {
  A_positive
  A_negative
  B_positive
  B_negative
  AB_positive
  AB_negative
  O_positive
  O_negative
}

enum UserRole {
  ADMIN
  PATIENT
  DOCTOR
}

enum UserStatus {
  ACTIVE
  INACTIVE
  DELETED
}

enum UserGender {
  Male
  Female
}

enum AppointmentStatus {
  SCHEDULED
  INPROGRESS
  COMPLETED
  CANCEL
}

enum PaymentStatus {
  PAID
  UNPAID
}
